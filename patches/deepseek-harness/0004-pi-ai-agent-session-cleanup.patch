diff --git a/packages/llm/llm-pi-ai/tests/session-resources.spec.ts b/packages/llm/llm-pi-ai/tests/session-resources.spec.ts
new file mode 100644
index 000000000..22397ed2f
--- /dev/null
+++ b/packages/llm/llm-pi-ai/tests/session-resources.spec.ts
@@ -0,0 +1,259 @@
+import { cleanupSessionResources, registerSessionResourceCleanup } from '@earendil-works/pi-ai'
+import {
+  getOpenAICodexWebSocketDebugStats,
+  resetOpenAICodexWebSocketDebugStats,
+} from '@earendil-works/pi-ai/api/openai-codex-responses'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import LlmRuntime from '@deepseek-ai/dsh-llm'
+import * as LlmPiAi from '@deepseek-ai/dsh-llm-pi-ai'
+import SessionStore, { SessionId, type SessionId as SessionIdType } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import { afterEach, beforeEach, describe, expect, it, vi, type MockInstance } from 'vitest'
+
+const liveContexts = new Set<Context>()
+
+class FakeCodexWebSocket {
+  static readonly instances: FakeCodexWebSocket[] = []
+
+  readonly sent: string[] = []
+  readonly closes: { code?: number; reason?: string }[] = []
+  readyState = 0
+  private readonly listeners = new Map<string, Set<(event: unknown) => void>>()
+
+  constructor() {
+    FakeCodexWebSocket.instances.push(this)
+    queueMicrotask(() => {
+      this.readyState = 1
+      this.emit('open', {})
+    })
+  }
+
+  addEventListener(type: string, listener: (event: unknown) => void): void {
+    const listeners = this.listeners.get(type) ?? new Set()
+    listeners.add(listener)
+    this.listeners.set(type, listeners)
+  }
+
+  removeEventListener(type: string, listener: (event: unknown) => void): void {
+    this.listeners.get(type)?.delete(listener)
+  }
+
+  send(payload: string): void {
+    this.sent.push(payload)
+    const response = {
+      type: 'response.completed',
+      response: {
+        id: `response-${this.sent.length}`,
+        status: 'completed',
+        output: [],
+        usage: { input_tokens: 1, output_tokens: 0, total_tokens: 1 },
+      },
+    }
+    queueMicrotask(() => { this.emit('message', { data: JSON.stringify(response) }) })
+  }
+
+  close(code?: number, reason?: string): void {
+    this.closes.push({
+      ...code === undefined ? {} : { code },
+      ...reason === undefined ? {} : { reason },
+    })
+    this.readyState = 3
+  }
+
+  private emit(type: string, event: unknown): void {
+    for (const listener of this.listeners.get(type) ?? []) listener(event)
+  }
+}
+
+async function harness(): Promise<Context> {
+  const ctx = new Context()
+  liveContexts.add(ctx)
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(SystemPrompt, { persona: 'You run lifecycle tests.' })
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(LlmPiAi, {
+    providers: {
+      'openai-codex': {
+        apiKeyEnv: 'PI_TEST_KEY',
+        transport: 'websocket',
+      },
+    },
+  })
+  return ctx
+}
+
+async function run(ctx: Context, sessionId: SessionIdType): Promise<unknown[]> {
+  const chunks: unknown[] = []
+  for await (const chunk of ctx.llm.stream({
+    provider: 'openai-codex',
+    model: 'gpt-5.4',
+    messages: [],
+    sessionId,
+  })) chunks.push(chunk)
+  return chunks
+}
+
+function idleTimerFrom(setTimeoutSpy: MockInstance<typeof globalThis.setTimeout>): unknown {
+  const index = setTimeoutSpy.mock.calls.findLastIndex(call => call[1] === 5 * 60 * 1000)
+  if (index < 0) throw new Error('pi-ai did not schedule its five-minute idle expiry')
+  const result = setTimeoutSpy.mock.results[index]
+  if (result?.type !== 'return') throw new Error('pi-ai idle expiry did not return a timer')
+  return result.value
+}
+
+beforeEach(() => {
+  const claim = Buffer.from(JSON.stringify({
+    'https://api.openai.com/auth': { chatgpt_account_id: 'account-test' },
+  })).toString('base64url')
+  vi.stubEnv('PI_TEST_KEY', `e30.${claim}.signature`)
+  vi.stubGlobal('WebSocket', FakeCodexWebSocket)
+})
+
+afterEach(async () => {
+  await Promise.all([...liveContexts].map(ctx => ctx.fiber.dispose()))
+  liveContexts.clear()
+  cleanupSessionResources()
+  resetOpenAICodexWebSocketDebugStats()
+  FakeCodexWebSocket.instances.length = 0
+  vi.unstubAllEnvs()
+  vi.unstubAllGlobals()
+  vi.restoreAllMocks()
+})
+
+describe('pi-ai session resources', () => {
+  it('reuses one keyed Codex WebSocket until the exact Agent handle is disposed', async () => {
+    const setTimeoutSpy = vi.spyOn(globalThis, 'setTimeout')
+    const clearTimeoutSpy = vi.spyOn(globalThis, 'clearTimeout')
+    const ctx = await harness()
+    const sessionId = SessionId('pi-ai-agent-resource-owner')
+    const firstOwner = await ctx.agents.create({
+      sessionId,
+      agentOptions: { provider: 'openai-codex', model: 'gpt-5.4' },
+    })
+
+    expect((await run(ctx, sessionId)).at(-1)).toMatchObject({ type: 'finish' })
+    expect((await run(ctx, sessionId)).at(-1)).toMatchObject({ type: 'finish' })
+    expect(FakeCodexWebSocket.instances).toHaveLength(1)
+    expect(FakeCodexWebSocket.instances[0]?.sent).toHaveLength(2)
+    expect(FakeCodexWebSocket.instances[0]?.closes).toEqual([])
+    expect(getOpenAICodexWebSocketDebugStats(sessionId)).toMatchObject({
+      requests: 2,
+      connectionsCreated: 1,
+      connectionsReused: 1,
+    })
+    const firstIdleTimer = idleTimerFrom(setTimeoutSpy)
+
+    await firstOwner.dispose()
+
+    expect(clearTimeoutSpy).toHaveBeenCalledWith(firstIdleTimer)
+    expect(FakeCodexWebSocket.instances[0]?.closes).toEqual([
+      { code: 1000, reason: 'debug_close' },
+    ])
+    expect(ctx.agents.get(sessionId)).toBeUndefined()
+    expect(ctx.sessions.get(sessionId)).toBeUndefined()
+
+    const replacement = await ctx.agents.create({
+      sessionId,
+      agentOptions: { provider: 'openai-codex', model: 'gpt-5.4' },
+    })
+    expect((await run(ctx, sessionId)).at(-1)).toMatchObject({ type: 'finish' })
+    expect(FakeCodexWebSocket.instances).toHaveLength(2)
+    expect(FakeCodexWebSocket.instances[1]?.closes).toEqual([])
+
+    await replacement.dispose()
+
+    expect(FakeCodexWebSocket.instances[1]?.closes).toEqual([
+      { code: 1000, reason: 'debug_close' },
+    ])
+    await ctx.fiber.dispose()
+  })
+
+  it('cleans a used agentless Session on its exact store disposal edge', async () => {
+    const setTimeoutSpy = vi.spyOn(globalThis, 'setTimeout')
+    const clearTimeoutSpy = vi.spyOn(globalThis, 'clearTimeout')
+    const ctx = await harness()
+    const sessionId = SessionId('pi-ai-agentless-session-owner')
+    const session = ctx.sessions.prepare(sessionId)
+    const disposeSession = ctx.sessions.enter(session)
+    ctx.sessions.announce(session)
+
+    expect((await run(ctx, sessionId)).at(-1)).toMatchObject({ type: 'finish' })
+    expect((await run(ctx, sessionId)).at(-1)).toMatchObject({ type: 'finish' })
+    expect(FakeCodexWebSocket.instances).toHaveLength(1)
+    expect(FakeCodexWebSocket.instances[0]?.sent).toHaveLength(2)
+    expect(FakeCodexWebSocket.instances[0]?.closes).toEqual([])
+    const idleTimer = idleTimerFrom(setTimeoutSpy)
+
+    disposeSession()
+
+    expect(clearTimeoutSpy).toHaveBeenCalledWith(idleTimer)
+    expect(FakeCodexWebSocket.instances[0]?.closes).toEqual([
+      { code: 1000, reason: 'debug_close' },
+    ])
+    await ctx.fiber.dispose()
+  })
+
+  it('contains aggregate cleanup failure after pi-ai still closes the transport', async () => {
+    const ctx = await harness()
+    const warn = vi.spyOn(ctx.logger, 'warn').mockImplementation(() => undefined)
+    const sessionId = SessionId('pi-ai-cleanup-failure-owner')
+    const owner = await ctx.agents.create({
+      sessionId,
+      agentOptions: { provider: 'openai-codex', model: 'gpt-5.4' },
+    })
+    const unregisterFailure = registerSessionResourceCleanup(() => {
+      throw new Error('test cleanup failure')
+    })
+    try {
+      expect((await run(ctx, sessionId)).at(-1)).toMatchObject({ type: 'finish' })
+
+      await expect(owner.dispose()).resolves.toBeUndefined()
+
+      expect(FakeCodexWebSocket.instances[0]?.closes).toEqual([
+        { code: 1000, reason: 'debug_close' },
+      ])
+      expect(warn).toHaveBeenCalledWith(
+        `llm-pi-ai: cleanup failed for session "${sessionId}": AggregateError: Failed to cleanup session resources`,
+      )
+    } finally {
+      unregisterFailure()
+    }
+  })
+
+  it('survives concurrent listener-fiber unload during nested-owner root disposal', async () => {
+    const setTimeoutSpy = vi.spyOn(globalThis, 'setTimeout')
+    const clearTimeoutSpy = vi.spyOn(globalThis, 'clearTimeout')
+    const ctx = await harness()
+    const sessionId = SessionId('pi-ai-root-disposal-owner')
+    let creating!: ReturnType<typeof ctx.agents.create>
+    await ctx.plugin(Object.assign((ownerCtx: Context) => {
+      creating = ownerCtx.agents.create({
+        sessionId,
+        agentOptions: { provider: 'openai-codex', model: 'gpt-5.4' },
+      })
+    }, { inject: ['agents'] }))
+    await creating
+
+    expect((await run(ctx, sessionId)).at(-1)).toMatchObject({ type: 'finish' })
+    expect((await run(ctx, sessionId)).at(-1)).toMatchObject({ type: 'finish' })
+    expect(FakeCodexWebSocket.instances).toHaveLength(1)
+    expect(FakeCodexWebSocket.instances[0]?.sent).toHaveLength(2)
+    expect(FakeCodexWebSocket.instances[0]?.closes).toEqual([])
+    const idleTimer = idleTimerFrom(setTimeoutSpy)
+
+    await ctx.fiber.dispose()
+
+    expect(clearTimeoutSpy).toHaveBeenCalledWith(idleTimer)
+    expect(FakeCodexWebSocket.instances[0]?.closes).toEqual([
+      { code: 1000, reason: 'debug_close' },
+    ])
+  })
+})
