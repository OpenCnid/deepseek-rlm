@@ -0,0 +1,39 @@
+import { describe, expect, it } from 'vitest'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { foldSubagentDeletion, SubagentError } from '../src/index.ts'
+
+function event(childId: string, data: Record<string, unknown> = {}): SessionEvent {
+  return {
+    type: 'subagent/deleted',
+    seq: 0,
+    time: 100,
+    data: {
+      version: 1,
+      childId,
+      label: 'research',
+      deletedAt: 99,
+      ...data,
+    },
+  } as SessionEvent
+}
+
+describe('continuable deletion tombstones', () => {
+  it('folds the first parent-owned tombstone for an exact child address', () => {
+    const childId = SessionId('child-1')
+    expect(foldSubagentDeletion([event(childId)], childId)).toEqual({
+      version: 1,
+      childId,
+      label: 'research',
+      deletedAt: 99,
+    })
+    expect(foldSubagentDeletion([event('child-2')], childId)).toBeUndefined()
+  })
+
+  it('fails loud on a malformed tombstone for the requested child', () => {
+    expect(() => foldSubagentDeletion(
+      [event('child-1', { deletedAt: 'never' })],
+      SessionId('child-1'),
+    )).toThrowError(expect.objectContaining<Partial<SubagentError>>({ code: 'CORRUPT_DELETION' }))
+  })
+})
