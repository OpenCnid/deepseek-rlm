+  /** Validate a selected effort against the exact route before child publication. */
+  private async validateReasoningEffort(options: AgentOptions, signal: AbortSignal): Promise<void> {
+    if (options.reasoningEffort === undefined) return
+    if (options.provider === undefined || options.model === undefined) {
+      throw new SubagentError(
+        'a continuable child reasoning effort requires an exact provider and model',
+        'INVALID_ARGUMENT',
+      )
+    }
+    const llm = this.ctx.get('llm')
+    if (llm === undefined) {
+      throw new SubagentError('continuable reasoning requires the llm service', 'CONTINUATION_UNAVAILABLE')
+    }
+    const info = await llm.resolveModelInfo(options.provider, options.model, signal)
+    if (!info.reasoning?.efforts.some(effort => effort.id === options.reasoningEffort)) {
+      throw new SubagentError(
+        `reasoning effort "${options.reasoningEffort}" is not supported by ${options.provider}/${options.model}`,
+        'INVALID_ARGUMENT',
+      )
+    }
+  }
