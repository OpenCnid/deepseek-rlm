{
  "name": "@deepseek-rlm/dsh-rlm-jupyter",
  "version": "0.1.0-preview.0",
  "description": "Persistent Jupyter Service Provider and native DSH RLM host bridge",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-rlm/dsh-rlm": "workspace:*",
    "@deepseek-rlm/dsh-rlm-prime-runtime": "workspace:*",
    "@deepseek-ai/schemastery": "3.18.1",
    "zeromq": "6.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7"
  }
}
