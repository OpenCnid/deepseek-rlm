{
  "name": "deepseek-rlm",
  "version": "0.1.0-preview.0",
  "private": true,
  "description": "Native persistent RLM capability seam for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.14.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsx scripts/stage-python-assets.ts && tsc -b",
    "clean": "tsx scripts/clean.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "oxlint packages scripts tests",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:python": "uv run --project python/dsh-rlm-runtime --with-editable vendor/prime-agent-runtime --with pytest pytest -q python/dsh-rlm-runtime/tests vendor/prime-agent-runtime/test/test_harness.py vendor/prime-agent-runtime/test/test_subagent_registry.py vendor/prime-agent-runtime/test/test_mcp_base.py -k \"not open_session_uses_headers_signature and not open_session_uses_http_client_signature\"",
    "provenance": "tsx scripts/verify-provenance.ts",
    "verify:patches": "tsx scripts/verify-dsh-patches.ts",
    "package:check": "tsx scripts/check-packages.ts",
    "package:bundle": "pnpm build && tsx scripts/pack.ts && tsx scripts/smoke-install.ts",
    "package:smoke": "tsx scripts/smoke-install.ts",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm test:python && pnpm provenance && pnpm verify:patches && pnpm package:check && pnpm test:integration && pnpm test:e2e"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-projection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "20.19.11",
    "oxlint": "1.76.0",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "yaml": "2.8.1"
  }
}
